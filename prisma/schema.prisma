generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:../db/custom.db"
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Snapshot {
  id               Int      @id @default(autoincrement())
  hashName         String
  nameCn           String
  steamPrice       Float?
  buffPrice        Float?
  igxePrice        Float?
  buffToSteamRatio Float?
  igxeToSteamRatio Float?
  igxeToBuffRatio  Float?
  createdAt        DateTime @default(now())

  @@index([hashName, createdAt])
  @@index([createdAt])
}
